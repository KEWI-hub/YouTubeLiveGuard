{
  "manifest_version": 3,
  "name": "YouTube Live Guard",
  "version": "1.0.1",
  "description": "ตรวจคุณภาพไลฟ์ YouTube, วิเคราะห์สาเหตุกระตุก และกด LIVE ให้อัตโนมัติเมื่อไลฟ์กระตุกหรือหลุดจาก Live Now",
  "permissions": ["storage"],
  "action": {
    "default_title": "YouTube Live Guard",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["defaults.js", "content-isolated.js"],
      "run_at": "document_idle"
    }
  ]
}
